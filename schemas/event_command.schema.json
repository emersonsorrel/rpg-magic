{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-magic.dev/schemas/event_command.schema.json",
  "title": "Event Command",
  "description": "One command from the closed event vocabulary (design doc 3.3). The LLM never emits code -- only arrays of these. Anything outside this vocabulary is rejected at validation. Recursion: nested scripts ($defs/script) point back at this schema's root.",

  "type": "object",
  "required": ["op"],
  "properties": {
    "op": {
      "description": "The complete command palette. Adding an op here means teaching the Event Runner to execute it.",
      "enum": [
        "SHOW_TEXT",
        "SHOW_CHOICE",
        "SET_FLAG",
        "IF_FLAG",
        "GIVE_ITEM",
        "TAKE_ITEM",
        "START_BATTLE",
        "WARP",
        "MOVE_ENTITY",
        "PLAY_SFX",
        "WAIT",
        "END"
      ]
    }
  },

  "allOf": [
    {
      "if": { "properties": { "op": { "const": "SHOW_TEXT" } }, "required": ["op"] },
      "then": {
        "required": ["text"],
        "properties": {
          "speaker": { "$ref": "#/$defs/speaker" },
          "text": { "$ref": "#/$defs/dialogue" }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "SHOW_CHOICE" } }, "required": ["op"] },
      "then": {
        "required": ["prompt", "options"],
        "properties": {
          "speaker": { "$ref": "#/$defs/speaker" },
          "prompt": { "$ref": "#/$defs/dialogue" },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["label", "script"],
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 48 },
                "script": { "$ref": "#/$defs/script" }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "SET_FLAG" } }, "required": ["op"] },
      "then": {
        "required": ["flag", "value"],
        "properties": {
          "flag": { "$ref": "#/$defs/identifier" },
          "value": { "type": "boolean" }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "IF_FLAG" } }, "required": ["op"] },
      "then": {
        "required": ["flag", "then"],
        "properties": {
          "flag": { "$ref": "#/$defs/identifier" },
          "then": { "$ref": "#/$defs/script" },
          "else": { "$ref": "#/$defs/script" }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "GIVE_ITEM" } }, "required": ["op"] },
      "then": {
        "required": ["item_id", "qty"],
        "properties": {
          "item_id": { "$ref": "#/$defs/identifier" },
          "qty": { "$ref": "#/$defs/quantity" }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "TAKE_ITEM" } }, "required": ["op"] },
      "then": {
        "required": ["item_id", "qty"],
        "properties": {
          "item_id": { "$ref": "#/$defs/identifier" },
          "qty": { "$ref": "#/$defs/quantity" }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "START_BATTLE" } }, "required": ["op"] },
      "then": {
        "required": ["encounter_id"],
        "properties": {
          "encounter_id": { "$ref": "#/$defs/identifier" },
          "on_win": { "$ref": "#/$defs/script" },
          "on_lose": { "$ref": "#/$defs/script" }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "WARP" } }, "required": ["op"] },
      "then": {
        "required": ["to_zone", "to_x", "to_y"],
        "properties": {
          "to_zone": { "$ref": "#/$defs/identifier" },
          "to_x": { "$ref": "#/$defs/tile_coord" },
          "to_y": { "$ref": "#/$defs/tile_coord" }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "MOVE_ENTITY" } }, "required": ["op"] },
      "then": {
        "required": ["entity_id", "path"],
        "properties": {
          "entity_id": { "$ref": "#/$defs/identifier" },
          "path": {
            "description": "Absolute tile coordinates, walked in order. Absolute (not relative) so a partially-run cutscene cannot drift.",
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": ["x", "y"],
              "properties": {
                "x": { "$ref": "#/$defs/tile_coord" },
                "y": { "$ref": "#/$defs/tile_coord" }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "PLAY_SFX" } }, "required": ["op"] },
      "then": {
        "required": ["sfx_tag"],
        "properties": { "sfx_tag": { "$ref": "#/$defs/tag" } }
      }
    },
    {
      "if": { "properties": { "op": { "const": "WAIT" } }, "required": ["op"] },
      "then": {
        "required": ["frames"],
        "properties": {
          "frames": { "type": "integer", "minimum": 1, "maximum": 600 }
        }
      }
    }
  ],

  "unevaluatedProperties": false,

  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(:[a-z0-9_]+)?$"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "tile_coord": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "speaker": {
      "description": "Entity id of the speaker, or null for narration.",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 48 }
      ]
    },
    "dialogue": {
      "description": "One text box. Hard cap keeps a line inside the 16-bit dialogue window without measuring.",
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "script": {
      "description": "An array of commands. Recurses into this file's root.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#" }
    }
  }
}
