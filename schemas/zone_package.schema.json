{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-magic.dev/schemas/zone_package.schema.json",
  "title": "Zone Package",
  "description": "The handoff artifact between backend and client (design doc 3.2). One document fully describes one playable zone. Shape stays close to Tiled TMJ so Phaser's tilemap loader needs minimal adaptation.",

  "type": "object",
  "required": [
    "schema_version", "id", "kind", "width", "height", "tile_size",
    "tileset", "layers", "entities", "warps", "encounters", "summary"
  ],
  "additionalProperties": false,

  "properties": {
    "schema_version": {
      "description": "Bumped on any breaking change to this schema. Present from day one on purpose.",
      "type": "integer",
      "minimum": 1
    },
    "id": { "$ref": "#/$defs/identifier" },
    "kind": { "enum": ["town", "dungeon", "wilderness", "interior"] },

    "width":  { "type": "integer", "minimum": 8, "maximum": 128 },
    "height": { "type": "integer", "minimum": 8, "maximum": 128 },
    "tile_size": { "type": "integer", "enum": [16] },
    "tileset": { "$ref": "#/$defs/identifier" },

    "layers": {
      "description": "Row-major, width*height entries each. Length is checked semantically against width*height, not by this schema.",
      "type": "object",
      "required": ["ground", "decor", "collision"],
      "additionalProperties": false,
      "properties": {
        "ground": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "decor": {
          "description": "0 means empty.",
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "collision": {
          "description": "0 walkable, 1 blocked.",
          "type": "array",
          "items": { "type": "integer", "enum": [0, 1] }
        }
      }
    },

    "entities": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/entity" }
    },

    "warps": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/warp" }
    },

    "encounters": {
      "type": "object",
      "required": ["enabled", "table"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "rate": {
          "description": "Steps between encounter checks. Ignored when disabled.",
          "type": "integer", "minimum": 4, "maximum": 128
        },
        "table": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["encounter_id", "weight"],
            "additionalProperties": false,
            "properties": {
              "encounter_id": { "$ref": "#/$defs/identifier" },
              "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
              "level": { "type": "integer", "minimum": 1, "maximum": 99 }
            }
          }
        }
      }
    },

    "music_tag": { "$ref": "#/$defs/tag" },

    "summary": {
      "description": "2-3 sentences written back into the ledger. This, not the full package, is what neighbouring zones get to see.",
      "type": "string",
      "minLength": 16,
      "maxLength": 400
    },

    "declares_flags": {
      "description": "Flags this zone introduces. SET_FLAG / IF_FLAG may only touch a flag already in the ledger or declared here.",
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },

    "fulfills_obligations": {
      "description": "Engine-owned. Written from ledger constraints before authoring, not by the model. The validator refuses to commit unless each listed obligation is actually satisfied by this zone's contents.",
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },

    "proposals": {
      "description": "Design doc 4.5, asymmetric trust. The model may propose new content here; it becomes real only if the ledger has an open slot. Never mechanically live. Kept structurally separate from committed content on purpose.",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["kind", "summary"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["key_item", "sidequest", "npc", "location", "lore"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    }
  },

  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "tag": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(:[a-z0-9_]+)?$" },
    "tile_coord": { "type": "integer", "minimum": 0, "maximum": 127 },

    "entity": {
      "type": "object",
      "required": ["id", "type", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["npc", "chest", "sign", "prop", "trigger"] },
        "x": { "$ref": "#/$defs/tile_coord" },
        "y": { "$ref": "#/$defs/tile_coord" },
        "sprite_tags": {
          "description": "Assets are addressed by tag, never filename (design doc 3.4). Unresolvable tags degrade to a generic sprite; they never block a commit.",
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/tag" }
        },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "trigger": { "enum": ["interact", "touch", "auto", "none"] },
        "blocking": {
          "description": "Whether the entity occupies its tile. Defaults true for npc/chest/sign/prop, false for trigger.",
          "type": "boolean"
        },
        "once": {
          "description": "Script runs at most once per save; the runner sets a hidden flag keyed on entity id.",
          "type": "boolean"
        },
        "script": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "event_command.schema.json" }
        }
      }
    },

    "warp": {
      "type": "object",
      "required": ["x", "y", "to_zone", "to_x", "to_y"],
      "additionalProperties": false,
      "properties": {
        "x": { "$ref": "#/$defs/tile_coord" },
        "y": { "$ref": "#/$defs/tile_coord" },
        "to_zone": { "$ref": "#/$defs/identifier" },
        "to_x": { "$ref": "#/$defs/tile_coord" },
        "to_y": { "$ref": "#/$defs/tile_coord" },
        "locked": {
          "description": "A gate. This is the shape an obligation's required_by end takes.",
          "type": "object",
          "required": ["requires_item"],
          "additionalProperties": false,
          "properties": {
            "requires_item": { "$ref": "#/$defs/identifier" },
            "consumes": { "type": "boolean" },
            "locked_text": { "type": "string", "minLength": 1, "maxLength": 180 }
          }
        }
      }
    }
  }
}
