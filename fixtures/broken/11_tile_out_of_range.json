  "music_tag": "town_calm",
  "summary": "Callow Ford, a river town of nine houses, cut off to the south by high water. Nine days ago the mine upriver flooded and the river began to run warm. Mayor Helle wants it looked at; the smith Dorn wants it left alone.",
  "declares_flags": [
    "has_ember_sigil",
    "mayor_warned_us"
  ],
  "fulfills_obligations": [
    "obl_ember_sigil"
  ],
  "proposals": [
    {
      "kind": "sidequest",
      "name": "The sandbag line",
      "summary": "Helle mentions sandbagging the south bank. There is no open slot for a fetch quest in this zone, so this stays flavour text with no mechanical effect."
    }
  ]
}
